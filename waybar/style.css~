/* Global Styles */
* {
    border: none;
    border-radius: 0px;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-weight: bold;
    font-size: 12px;
    min-height: 0;
    transition: 0.1s;
}

/* Waybar */
window#waybar {
    background: rgba(21, 18, 27, 0);
    color: #cdd6f4;
}

/* Tooltip */
tooltip {
    background: #1e1e2e;
    border-radius: 8px;
    border: 1.5px solid #11111b;
    transition: 0.3s;
}

/* Workspaces */
#workspaces {
    background: #1e1e2e;
    border-radius: 20px;
    margin-left: 0px;
    padding: 0px 20px;
}

#workspaces button {
    padding: 5px;
    color: #313244;
    /*margin-right: 5px;*/
    border-radius: 10px;
}

#workspaces button.active {
    color: #a6adc8;
}

#workspaces button.focused {
    color: #a6adc8;
    background: #11111b; /* Reintroduced for better visibility */
}

#workspaces button.urgent {
    color: #11111b;
    background: #a6e3a1;
    border-radius: 1px;
}


/* Custom Elements */
#custom-power_profile,
#custom-weather,
#window,
#clock,
#mpd,
#battery,
#pulseaudio,
#network,
#bluetooth,
#temperature,
#workspaces,
#tray,
#backlight {
    background: #1e1e2e;
    opacity: 0.8;
    padding: 0px 10px;
    margin: 0;
    margin-top: 5px;
    border: 1px solid #181825;
}

/* Temperature */
#temperature {
    border-radius: 20px 0px 0px 20px;
}

#temperature.critical {
    color: #eba0ac;
}

/* Backlight */
#backlight {
    border-radius: 20px 0px 0px 20px;
    padding-left: 7px;
}

/* Tray */
#tray {
    border-radius: 20px;
    margin-right: 5px;
    padding: 0px 4px;
}

/* Clock */
#clock {
    color: #fab387;
    border-radius: 20px;
    margin-left: 5px;
    border-right: 0px;
    transition: 0.3s;
    padding-left: 7px;
}

/* MPD */
#mpd {
    color: #87eefa;
    border-radius: 20px;
    margin-left: 5px;
    border-right: 0px;
    transition: 0.3s;
    padding-left: 7px;
}

/* Network */
#network {
    color: #f9e2af;
    border-radius: 20px 0px 0px 20px;
    border-left: 0px;
    border-right: 0px;
}

/* Bluetooth */
#bluetooth {
    color: #89b4fa;
    border-radius: 20px;
    margin-right: 10px;
}

/* Pulseaudio */
#pulseaudio {
    color: #89b4fa;
    border-left: 0px;
    border-right: 0px;
}

#pulseaudio.microphone {
    color: #cba6f7;
    border-left: 0px;
    border-right: 0px;
    border-radius: 0px 20px 20px 0px;
    margin-right: 5px;
    padding-right: 8px;
}

/* Battery */
#battery {
    color: #a6e3a1;
    border-radius: 0 20px 20px 0;
    margin-right: 5px;
    border-left: 0px;
}

/* Custom Weather */
#custom-weather {
    border-radius: 20px;
    border-right: 0px;
    margin-left: 0px;
}
