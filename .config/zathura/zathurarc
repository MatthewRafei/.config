# zathura — PDF viewer, in the same HUD style as the rest of the desktop.
# Colours live in ./colors, generated from the wallpaper by
# ~/.config/theme/wallpaper-theme (open windows reload them live).
#
# Keys worth knowing (zathura defaults unless marked):
#   j / k, J / K      scroll / next and previous page
#   gg / G            first / last page          123G  go to page 123
#   / ?  n N          search forward / back, next / previous match
#   Tab               table of contents (o or Enter opens an entry)
#   a / s             fit page / fit width       + - =  zoom in / out / reset
#   d                 two pages side by side     r      rotate
#   Ctrl+R            dark pages on / off  (on by default here)
#   f                 follow a link by its number
#   Ctrl+N            hide / show the status bar (here)
#   R                 reload the file            q      quit

include colors

set font                    "JetBrainsMono Nerd Font 10"
set guioptions              "s"             # status bar only, no scroll bars
set statusbar-h-padding     14
set statusbar-v-padding     6
set statusbar-home-tilde    true
set statusbar-basename      true
set statusbar-page-percent  true
set window-title-basename   true
set window-title-page       true

# dark pages that follow the theme; pictures keep their real colours
set recolor                 true
set recolor-keephue         true
set recolor-reverse-video   true

# layout and movement
set adjust-open             "width"
set page-v-padding          8
set page-h-padding          8
set scroll-page-aware       true
set scroll-step             60
set scroll-full-overlap     0.05
set zoom-step               10
set vertical-center         true
set incremental-search      true
set search-hadjust          true

# copy selected text to the normal clipboard, quietly
set selection-clipboard     clipboard
set selection-notification  false

map <C-n> toggle_statusbar
